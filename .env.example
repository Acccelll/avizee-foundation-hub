# AviZee — inventário de variáveis (Etapa 11.1 §12/§27).
# Nenhum valor real. Copie para `.env` local; `.env` NÃO é versionado.
# Escopo: [servidor] nunca chega ao navegador; [cliente] é público por definição.

# ── Ambiente ─────────────────────────────────────────────────────────────
# [servidor] fonte canônica de ambiente. Obrigatória fora de desenvolvimento.
# Valores: development | preview | staging | production | test
APP_ENV=development
# [cliente] derivado de APP_ENV no build. Divergência falha a verificação.
VITE_APP_ENV=development
# [cliente] rótulo de versão exibido na faixa técnica.
VITE_APP_VERSION=0.0.0-dev

# ── URL pública canônica ─────────────────────────────────────────────────
# [servidor] URL absoluta, sem barra final. HTTPS obrigatório fora de dev.
# Usada em sitemap, robots, canonical, Open Graph, JSON-LD e links de e-mail.
APP_PUBLIC_URL=http://localhost:8080

# ── Banco / autenticação (Lovable Cloud) ─────────────────────────────────
# [servidor]
SUPABASE_URL=https://exemplo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_exemplo
# [servidor] SEGREDO — jamais no navegador, em log ou em documento.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_exemplo
# [cliente] publicáveis por definição
VITE_SUPABASE_URL=https://exemplo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_exemplo
VITE_SUPABASE_PROJECT_ID=exemplo

# ── Cotação ──────────────────────────────────────────────────────────────
# [servidor] SEGREDO — sal do hash antiabuso. Obrigatório fora de
# desenvolvimento; sem ele o readiness falha. Rotacionável.
QUOTATION_HASH_SALT=troque-este-valor-apenas-em-desenvolvimento
# [servidor] destino interno aprovado das solicitações de cotação.
QUOTATION_INTERNAL_EMAIL=comercial@avizee.com.br

# ── Outbox ───────────────────────────────────────────────────────────────
# [servidor] SEGREDO — protege o endpoint do worker agendado.
OUTBOX_WORKER_SECRET=
# [servidor] identificador do worker; default derivado quando ausente.
OUTBOX_WORKER_ID=

# ── Central de Conteúdos ─────────────────────────────────────────────────
# [servidor] SEGREDO dedicado ao endpoint interno do scheduler editorial.
# Use valor aleatório com pelo menos 32 caracteres fora de desenvolvimento.
CONTENT_SCHEDULER_SECRET=

# ── E-mail transacional ──────────────────────────────────────────────────
# Em desenvolvimento/teste use `log`. Em produção, após concluir domínio e
# segredos externos, configure `resend`.
EMAIL_PROVIDER=log
# [servidor] SEGREDO — chave criada no Resend; não versionar.
RESEND_API_KEY=
# Remetente aprovado para o subdomínio transacional após sua criação.
RESEND_FROM=AviZee <cotacoes@envios.avizee.com.br>
# Caixa comercial recebe as respostas dos destinatários.
EMAIL_REPLY_TO=comercial@avizee.com.br

# ── Demais provedores ────────────────────────────────────────────────────
# [servidor] storage real pendente de homologação.
STORAGE_PROVIDER=local
# [servidor]
CAPTCHA_PROVIDER=null
# [servidor]
LOG_LEVEL=info
