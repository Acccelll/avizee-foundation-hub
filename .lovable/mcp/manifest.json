      {
        "name": "suggest_terms",
        "title": "Sugerir termos e códigos",
        "description": "Autocomplete do catálogo público da AviZee: devolve sugestões de famílias e códigos (SKU) a partir de um termo parcial, tolerante a acentos e erros de digitação.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "minLength": 2,
              "maxLength": 50,
              "description": "Termo parcial com pelo menos 2 caracteres."
            }
          },
          "required": [
            "q"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "suggestions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "sku",
                      "family"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "sublabel": {
                    "type": [
                      "string",
                      "null"
                    ]
