      {
        "name": "search_catalog",
        "title": "Buscar no catálogo AviZee",
        "description": "Busca famílias de produtos publicadas no catálogo público da AviZee por termo, código (SKU), categoria, segmento ou aplicação. Não retorna preços nem marcas de terceiros.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "maxLength": 100,
              "description": "Termo livre, nome do produto ou código/SKU."
            },
            "categoria": {
              "type": "string",
              "maxLength": 100,
              "description": "Slug da categoria pública."
            },
            "segmento": {
              "type": "string",
              "maxLength": 100,
              "description": "Slug do segmento (ex.: avicultura)."
            },
            "aplicacao": {
              "type": "string",
              "maxLength": 100,
              "description": "Slug da aplicação/necessidade."
            },
            "pagina": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Página começando em 1."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "slug": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "summary": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "categorySlug": {
                    "type": "string"
                  },
                  "categoryName": {
                    "type": "string"
                  },
                  "segments": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "applications": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "variationCount": {
                    "type": "number"
                  },
                  "skus": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "matchedSku": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "image": {
                    "type": "object",
